# This file is yadm's repo-level .gitignore (work tree = $HOME).
# It is NOT the global git excludes file — that's ~/.config/git/ignore.
# Patterns with a leading "/" anchor to $HOME and only affect yadm.

*~
.#*
*.pyc
*.elc
.aws/*
.local/share/Trash/*
.cache-loader*
.ipynb_checkpoints/
__pycache__/
*ediff-merge*

node_modules/
.DS_Store

# Local Variables:
# mode: gitignore
# End:
/.dir-locals.el
.direnv/
/.spacedrive
nohup.out
/.aider*
/python/pdf-anonymizer/.aider.CONVENTIONS.md

.overmind
.codanna*
.direnv
.fastembed_cache
.serena
.ck

# PI coding agent
agent_plans/
.pi/
!/.pi/
/.pi/agent/auth.json
/.pi/agent/sessions/
/.pi/agent/cache/
