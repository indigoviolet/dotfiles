## Priority order: First obtained value for each parameter is used


Host minions-tunnel
  HostName minions
  LocalForward 2022 localhost:2022
  ExitOnForwardFailure yes
  ServerAliveInterval 5
  ServerAliveCountMax 2
  ConnectTimeout 10
  ControlMaster no
  ControlPath none
  ProxyCommand /opt/homebrew/bin/coder --global-config "/Users/venky/Library/Application Support/coderv2" ssh --stdio %h


# et's SSH bootstrap for `et coder.minions:2022` must reach the workspace, not
# the local Mac. /etc/hosts maps coder.minions -> 127.0.0.1; the etserver data
# channel rides the autossh 2022 forward, and the socat on 2222 bridges to the
# workspace's sshd (via `coder ssh --stdio minions`). Without this, ssh defaults
# to port 22 = this Mac -> password prompt.
Host coder.minions
  HostName 127.0.0.1
  Port 2222
  StrictHostKeyChecking accept-new

Host *
  ControlMaster auto
  ControlPath ~/.ssh/master-%r@%h:%p
  ControlPersist 10m
  ForwardAgent yes
  ServerAliveInterval 30
  AddKeysToAgent yes
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

Host *
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"


# Local Variables:
# mode: ssh-config
# End:
