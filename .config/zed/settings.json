// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right",
    "tree_view": true
  },
  "disable_ai": false,
  "icon_theme": "Catppuccin Macchiato",
  "project_panel": {
    "dock": "right",
    "hide_gitignore": false,
    "hide_hidden": true,
  },
  "buffer_font_weight": 600.0,
  "buffer_font_family": "IndigovioleskaSemi Nerd Font Mono",
  "ssh_connections": [
    {
      "host": "hetzner1",
      "username": "venky",
      "args": [
        "-o",
        "ProxyCommand=cloudflared access tcp --hostname ssh.romansix.org"
      ],
      "projects": [
        {
          "paths": [
            "/home/venky/dev/puzzlebox"
          ]
        }
      ]
    },
    {
      "host": "minions.coder",
      "args": [],
      "projects": [
        {
          "paths": [
            "/workspaces/plus2/./"
          ]
        }
      ]
    }
  ],
  "edit_predictions": {
    "provider": "zed",
  },
  "buffer_line_height": "standard",
  "languages": {
    "Python": {
      "inlay_hints": {
        "enabled": true,
      },
      "language_servers": [
        // Enable ty, disable basedpyright, and enable all
        // other registered language servers (ruff, pylsp, pyright).
        // "ty",
        // "basedpyright"
        "pyright",
        "ruff",
      ],
      "show_whitespaces": "trailing",
      "indent_guides": {
        "background_coloring": "indent_aware",
        "coloring": "indent_aware",
      },
    },
  },
  "prettier": {
    "allowed": true,
  },
  "agent": {
    "dock": "left",
    "thinking_display": "always_collapsed",
    "expand_edit_card": false,
    "expand_terminal_card": false,
    "default_model": {
      "provider": "anthropic",
      "model": "claude-haiku-4-5-latest",
      "enable_thinking": true,
    },
    "inline_assistant_model": {
      "provider": "anthropic",
      "model": "claude-opus-4-6-latest",
    },
  },
  "agent_servers": {
    "pi-acp": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
    "codex-acp": {
      "type": "registry",
    },
    "opencode": {
      "type": "registry",
    },
  },
  "session": {
    "trust_all_worktrees": true,
  },

  "base_keymap": "VSCode",
  "ui_font_size": 15.0,
  "buffer_font_size": 14.0,
  "theme": "Dracula Solid",
}
